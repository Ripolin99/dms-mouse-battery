    "version": "1.0.0",
    "author": "ripolin",
    "type": "widget",
    "capabilities": ["dankbar-widget", "monitoring", "input-device"],
    "component": "./MouseBatteryWidget.qml",
    "icon": "mouse",
    "settings": "./MouseBatterySettings.qml",
    "requires_dms": ">=0.1.0",
    "requires": ["upower"],
    "permissions": [
        "settings_read",
        "settings_write"
    ]
}
